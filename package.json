{
  "name": "batch-fetch-postgres",
  "version": "1.0.0",
  "description": "POC: batch unrelated Postgres queries into a single network round trip instead of one call per query.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "example:dependent-queries": "tsx examples/dependentQueries.ts",
    "example:error-handling": "tsx examples/errorHandling.ts",
    "example:typed-results": "tsx examples/typedResults.ts",
    "example:query-builder": "tsx examples/queryBuilder.ts"
  },
  "license": "ISC",
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
